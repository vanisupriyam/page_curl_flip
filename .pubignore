# Build artifacts and IDE state — never ship.
.dart_tool/
**/.dart_tool/
build/
**/build/
*.iml
.idea/

# The example ships as source only: pub.dev's Example tab reads
# example/lib/main.dart. Platform scaffolding stays out of the archive.
example/android/
example/ios/
example/web/
example/test/
example/.gitignore
example/.metadata
example/analysis_options.yaml
example/README.md

# Golden baselines — CI artefacts, not package content.
test/goldens/

# The README demo GIF — GitHub serves it; it never ships in the archive.
doc/

# Local coverage output — never package content.
coverage/

# Golden failure dumps from red runs — debug artefacts only.
test/failures/
